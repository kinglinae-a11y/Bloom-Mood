rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection test
    match /test/connection {
      allow read: if true;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256;
    }

    function isValidMoodEntry(data) {
      return data.keys().hasAll(['id', 'userId', 'timestamp', 'emotionId', 'emotionName', 'category', 'intensity']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.timestamp is number &&
             data.emotionId is string && data.emotionId.size() <= 128 &&
             data.emotionName is string && data.emotionName.size() <= 128 &&
             data.category is string && data.category.size() <= 64 &&
             data.intensity is number;
    }

    function isValidJournalEntry(data) {
      return data.keys().hasAll(['id', 'userId', 'timestamp', 'content']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.timestamp is number &&
             data.content is string && data.content.size() <= 20000;
    }

    function isValidVoiceNote(data) {
      return data.keys().hasAll(['id', 'userId', 'timestamp', 'transcript']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.timestamp is number &&
             data.transcript is string && data.transcript.size() <= 20000;
    }

    // User profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if false;

      // Subcollection: Mood Entries
      match /moodEntries/{entryId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidMoodEntry(incoming()) && incoming().userId == userId;
      }

      // Subcollection: Journal Entries
      match /journalEntries/{entryId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidJournalEntry(incoming()) && incoming().userId == userId;
      }

      // Subcollection: Transcribed Voice Notes
      match /voiceNotes/{noteId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidVoiceNote(incoming()) && incoming().userId == userId;
      }
    }
  }
}
